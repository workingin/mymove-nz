# ==========================================
# Logs
# ==========================================
error_log
*.log

# ==========================================
# User uploaded content (not source code)
# ==========================================
admin/upload/uploads/*
admin/img/*
!admin/upload/uploads/.gitkeep

# Local scratch/source images not used by the site
admin/img/*-source.jpg

